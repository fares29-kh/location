# DriveTN en production. Généré par deploy/scripts/init-env.sh — ne pas commiter.
# Mots de passe : caractères hexadécimaux uniquement (ils sont insérés dans des URL).
# Copiez ce fichier dans un gestionnaire de mots de passe dès qu'il est rempli.
# MinIO n'est pas utilisé ici : les fichiers vont sur Hetzner Object Storage.

# hetzner ou azure. Ce fichier est le modèle Hetzner.
DEPLOY_TARGET=hetzner

# --- Domaine -----------------------------------------------------------------
APP_NAME=DriveTN
# Apex, sans https ni slash. Exemple : drivetn.tn
APP_DOMAIN=
APP_TIMEZONE=Africa/Tunis
# Adresse Let's Encrypt pour les alertes d'expiration. Une vraie boîte que vous lisez.
ACME_EMAIL=

# --- PostgreSQL (sur le volume /var/lib/drivetn) -----------------------------
POSTGRES_USER=drivetn
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=drivetn
POSTGRES_DATA_DIR=/var/lib/drivetn/postgres

# --- Redis (files d'attente et cache ; jetable en cas de sinistre) -----------
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_DATA_DIR=/var/lib/drivetn/redis

# --- Photos et documents : Object Storage Falkenstein (fsn1) -----------------
# La zone du serveur est Nuremberg. Les fichiers sont dans une autre ville.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=drivetn-public-__SUFFIX__
S3_BUCKET_PRIVATE=drivetn-private-__SUFFIX__
MEDIA_PUBLIC_URL=https://drivetn-public-__SUFFIX__.fsn1.your-objectstorage.com

# --- Sauvegardes : Object Storage Helsinki (hel1) ----------------------------
# Autre ville que les photos ET que le serveur. Le trafic interne Hetzner n'est pas facturé.
BACKUP_S3_ENDPOINT=https://hel1.your-objectstorage.com
BACKUP_S3_REGION=hel1
BACKUP_S3_BUCKET=drivetn-backups-__SUFFIX__
WALG_S3_PREFIX=s3://drivetn-backups-__SUFFIX__/postgres
RESTIC_REPOSITORY=s3:https://hel1.your-objectstorage.com/drivetn-backups-__SUFFIX__/restic
RESTIC_PASSWORD=__RESTIC_PASSWORD__
# Optionnel : URL https://healthchecks.io/... pingée après chaque sauvegarde.
HEALTHCHECKS_URL=

# Tableau de bord : https://admin.<domaine>/monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GRAFANA_ADMIN_PASSWORD__

# --- API ---------------------------------------------------------------------
SWAGGER_ENABLED=false
CORS_ORIGINS=
SEED_ON_START=true
SEED_DEMO_ACCOUNTS=false
DESIGN_PAGE_ENABLED=false

# Compte super-administrateur, créé une seule fois au premier démarrage.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Authentification --------------------------------------------------------
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
OTP_HASH_SECRET=__OTP_HASH_SECRET__
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
# reCAPTCHA v2, case à cocher, domaine madrasti.dev. Vide : pas de case sur la connexion.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# console : les codes OTP sont écrits dans les logs du worker, aucun SMS n'est envoyé.
MESSAGING_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DriveTN <noreply@example.com>
