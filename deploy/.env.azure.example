# DriveTN sur Azure. Généré par : bash deploy/scripts/init-env.sh azure
# Ne pas commiter. Copiez ce fichier dans un gestionnaire de mots de passe.
# Les clés de compte de stockage se collent entre guillemets doubles.

DEPLOY_TARGET=azure

# --- Domaine -----------------------------------------------------------------
APP_NAME=DriveTN
APP_DOMAIN=
APP_TIMEZONE=Africa/Tunis
ACME_EMAIL=

# --- PostgreSQL (disque de données monté sur /var/lib/drivetn) ---------------
POSTGRES_USER=drivetn
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=drivetn
POSTGRES_DATA_DIR=/var/lib/drivetn/postgres

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_DATA_DIR=/var/lib/drivetn/redis

# --- Photos : compte de stockage France Central ------------------------------
# Noms de comptes : lettres minuscules et chiffres uniquement, 3 à 24 caractères.
AZURE_MEDIA_ACCOUNT=drivetnmedia__SUFFIX__
AZURE_MEDIA_KEY=""
AZURE_MEDIA_CONTAINER=drivetn-public
AZURE_MEDIA_CONTAINER_PRIVATE=drivetn-private
MEDIA_PUBLIC_URL=https://drivetnmedia__SUFFIX__.blob.core.windows.net/drivetn-public

# --- Sauvegardes : autre compte, autre région (West Europe) ------------------
AZURE_BACKUP_ACCOUNT=drivetnbackup__SUFFIX__
AZURE_BACKUP_KEY=""
AZURE_BACKUP_CONTAINER=drivetn-backups
WALG_AZ_PREFIX=azure://drivetn-backups/postgres
RESTIC_REPOSITORY=azure:drivetn-backups:/restic
RESTIC_PASSWORD=__RESTIC_PASSWORD__
HEALTHCHECKS_URL=

# Tableau de bord : https://admin.<domaine>/monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GRAFANA_ADMIN_PASSWORD__

# --- API ---------------------------------------------------------------------
SWAGGER_ENABLED=false
CORS_ORIGINS=
SEED_ON_START=true
SEED_DEMO_ACCOUNTS=false
DESIGN_PAGE_ENABLED=false

ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Authentification --------------------------------------------------------
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
OTP_HASH_SECRET=__OTP_HASH_SECRET__
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

MESSAGING_PROVIDER=console
