# =============================================================================
# DriveTN - variables d'environnement
# Copiez ce fichier : cp .env.example .env   (ne commitez jamais .env)
# Les valeurs ci-dessous conviennent au développement local UNIQUEMENT.
# =============================================================================

# --- Général -----------------------------------------------------------------
# Nom affiché de la plateforme (modifiable sans toucher au code).
APP_NAME=DriveTN
# Domaine racine. Les portails sont servis sur :
#   client : http://<APP_DOMAIN> et http://app.<APP_DOMAIN>
#   agence : http://agency.<APP_DOMAIN>
#   admin  : http://admin.<APP_DOMAIN>
APP_DOMAIN=localhost
# Fuseau d'affichage. Les dates sont toujours stockées en UTC.
APP_TIMEZONE=Africa/Tunis
# Port HTTP publié par Traefik sur la machine hôte.
HTTP_PORT=80
# Vitrine du design system sur /design (les 3 portails). Mettez false en production.
DESIGN_PAGE_ENABLED=true

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=drivetn
# Utilisez uniquement des caractères alphanumériques (le mot de passe est inséré dans une URL).
POSTGRES_PASSWORD=drivetn_dev_postgres
POSTGRES_DB=drivetn
# Port exposé sur 127.0.0.1 en mode dev uniquement (docker-compose.dev.yml).
POSTGRES_PORT=5432

# --- Redis (cache, rate limiting, files BullMQ) ------------------------------
# Alphanumérique uniquement (inséré dans une URL).
REDIS_PASSWORD=drivetn_dev_redis
# Port exposé sur 127.0.0.1 en mode dev uniquement.
REDIS_PORT=6379

# --- MinIO (stockage S3 des images et documents) -----------------------------
# Image MinIO : les images officielles ne sont plus publiées sur Docker Hub,
# on utilise par défaut la build Chainguard (MinIO compilé depuis les sources).
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_ROOT_USER=drivetn
# 8 caractères minimum.
MINIO_ROOT_PASSWORD=drivetn_dev_minio
# Bucket public : photos de véhicules, logos d'agences. Servi par Traefik sous /media
# sur le domaine des portails ; l'API y écrit avec les identifiants MinIO ci-dessus.
S3_BUCKET_PUBLIC=drivetn-public
# Bucket privé : CIN, passeports, permis, preuves d'avance (URLs signées temporaires).
S3_BUCKET_PRIVATE=drivetn-private

# --- API ---------------------------------------------------------------------
# Documentation OpenAPI sur /api/docs. Désactivez-la en production si nécessaire.
SWAGGER_ENABLED=true
# Origines autorisées en CORS, séparées par des virgules. Vide = même origine uniquement
# (cas par défaut : Traefik sert l'API sous /api sur chaque sous-domaine).
CORS_ORIGINS=
# Exécute le seed idempotent au démarrage de l'API (paramètres, gouvernorats, lieux).
SEED_ON_START=true
# Crée les comptes de démo (admin@demo.tn, agency@demo.tn, customer@demo.tn). Jamais en production.
SEED_DEMO_ACCOUNTS=true

# --- Compte super-administrateur initial ---------------------------------------
# Créé au démarrage s'il n'existe pas encore (jamais modifié ensuite : changez le mot de
# passe depuis le portail admin). Laissez vide pour ne rien créer. Les trois champs sont
# requis ensemble ; une valeur invalide empêche l'API de démarrer.
ADMIN_EMAIL=
# Numéro tunisien à 8 chiffres, unique sur la plateforme.
ADMIN_PHONE=
# 8 caractères minimum, avec des lettres et des chiffres.
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Authentification ----------------------------------------------------------
# Secrets de 32 caractères minimum. En production, générez-les : openssl rand -base64 48
JWT_ACCESS_SECRET=dev_only_jwt_access_secret_change_me_in_production
# Clé HMAC des codes OTP stockés en base.
OTP_HASH_SECRET=dev_only_otp_hash_secret_change_me_in_production
# Durée de vie de l'access token (secondes) et du refresh token rotatif (jours).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookies « Secure » : true dès que la plateforme est servie en HTTPS.
COOKIE_SECURE=false
# reCAPTCHA v3 (score). Vide : la connexion ne lance pas de vérification.
# Clé de site : lue par le site. Clé secrète : lue uniquement par l'API.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Messagerie (OTP, rappels) -------------------------------------------------
# Fournisseur SMS / WhatsApp. « console » : les messages et codes OTP sont écrits
# dans les logs du worker (docker compose logs -f worker).
MESSAGING_PROVIDER=console
# SMTP des codes de confirmation email. Vide : le code est écrit dans les logs du worker.
# SMTP_SECURE=true pour le port 465, false pour STARTTLS (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DriveTN <noreply@localhost>
