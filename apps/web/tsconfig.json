{
  "extends": "@drivetn/config/tsconfig/next.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "messages/*.json",
    ".next/types/**/*.ts",
    "next.config.ts",
    "tailwind.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules"]
}
