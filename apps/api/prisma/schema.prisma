// Schéma Prisma DriveTN.
// Conventions : montants en millimes (Int), dates en UTC, tables en snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Paramètres globaux de la plateforme (TVA, timbre fiscal, commission par défaut...).
/// Les taux sont exprimés en points de base (1900 = 19 %), les montants en millimes.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// --- Comptes et sessions -----------------------------------------------------

enum UserRole {
  CUSTOMER
  AGENCY_OWNER
  AGENCY_STAFF
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum Locale {
  fr
  ar
  en
}

model User {
  id              String     @id @default(cuid())
  role            UserRole
  /// Renseigné uniquement pour le rôle ADMIN.
  adminRole       AdminRole? @map("admin_role")
  status          UserStatus @default(PENDING_VERIFICATION)
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  /// Format E.164 : +216XXXXXXXX.
  phone           String     @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  /// Toujours en minuscules.
  email           String?    @unique
  emailVerifiedAt DateTime?  @map("email_verified_at")
  passwordHash    String?    @map("password_hash")
  locale          Locale     @default(fr)
  /// Ville de résidence déclarée (affichée à l'agence).
  city            String?
  lastLoginAt     DateTime?  @map("last_login_at")
  /// Motif communiqué lors d'une suspension par l'administration.
  statusReason    String?    @map("status_reason")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  agency        Agency?
  bookings      Booking[]
  reviews       Review[]

  @@index([role, status])
  /// Recherche par fragment de numéro (pg_trgm). Les index de recherche sur les noms, l'e-mail et
  /// la ville portent sur des expressions : ils n'existent que dans la migration 20261008050000.
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_phone_search_idx")
  @@map("users")
}

/// Refresh token opaque, stocké haché (SHA-256). Une « famille » regroupe les rotations
/// successives d'une même session : la réutilisation d'un jeton révoqué révoque la famille.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
}

enum OtpChannel {
  SMS
  WHATSAPP
}

/// Code à usage unique envoyé par SMS ou WhatsApp, stocké haché (HMAC-SHA-256).
model OtpCode {
  id         String     @id @default(cuid())
  /// Format E.164.
  phone      String
  purpose    OtpPurpose
  channel    OtpChannel
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

// --- Géographie --------------------------------------------------------------

model Governorate {
  /// Code officiel à 2 chiffres (ex. « 11 » pour Tunis).
  code      String   @id
  slug      String   @unique
  nameFr    String   @map("name_fr")
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations   Location[]
  agencies    Agency[]
  delegations Delegation[]

  @@map("governorates")
}

/// Délégation, subdivision d'un gouvernorat (référentiel géré par l'administration).
model Delegation {
  id              String   @id @default(cuid())
  governorateCode String   @map("governorate_code")
  nameFr          String   @map("name_fr")
  nameAr          String   @map("name_ar")
  nameEn          String   @map("name_en")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  governorate    Governorate    @relation(fields: [governorateCode], references: [code], onDelete: Restrict)
  municipalities Municipality[]

  @@unique([governorateCode, nameFr])
  @@map("delegations")
}

/// Municipalité, rattachée à une délégation (référentiel géré par l'administration).
model Municipality {
  id           String   @id @default(cuid())
  delegationId String   @map("delegation_id")
  nameFr       String   @map("name_fr")
  nameAr       String   @map("name_ar")
  nameEn       String   @map("name_en")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  delegation Delegation @relation(fields: [delegationId], references: [id], onDelete: Restrict)

  @@unique([delegationId, nameFr])
  @@map("municipalities")
}

enum LocationType {
  AIRPORT
  CITY
  TRAIN_STATION
  PORT
}

/// Lieu de prise en charge ou de retour (aéroport, ville, gare, port).
model Location {
  id              String       @id @default(cuid())
  slug            String       @unique
  type            LocationType
  governorateCode String       @map("governorate_code")
  iataCode        String?      @map("iata_code")
  nameFr          String       @map("name_fr")
  nameAr          String       @map("name_ar")
  nameEn          String       @map("name_en")
  latitude        Float
  longitude       Float
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  governorate Governorate @relation(fields: [governorateCode], references: [code])
  bookings    Booking[]

  @@index([governorateCode])
  @@index([type, isActive])
  @@map("locations")
}

// --- Agences, flotte et réservations -------------------------------------------

enum AgencyStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  RETURNED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
  EXPIRED
}

enum PaymentKind {
  RENTAL
  REFUND
  DEPOSIT_HELD
  DEPOSIT_RETURNED
}

enum PaymentMethod {
  CASH
  CARD_TPE
  CHECK
  BANK_TRANSFER
  MOBILE_PAYMENT
  MONEY_ORDER
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
}

enum AgencyDocumentKind {
  TRADE_REGISTER
  TAX_ID
  INSURANCE
  MANAGER_ID
}

enum ReviewModerationStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

enum ReviewReportReason {
  OFFENSIVE
  SPAM
  PERSONAL_DATA
  OFF_TOPIC
}

/// Agence de location, rattachée à son propriétaire. Seules les agences ACTIVE sont visibles des clients.
model Agency {
  id                     String           @id @default(cuid())
  ownerId                String           @unique @map("owner_id")
  status                 AgencyStatus     @default(PENDING_REVIEW)
  name                   String
  /// Numéros nationaux à 8 chiffres.
  phone                  String
  whatsappPhone          String           @map("whatsapp_phone")
  email                  String?
  address                String
  governorateCode        String           @map("governorate_code")
  description            String           @default("")
  /// Clé du logo dans le bucket public (WebP), `null` sans logo.
  logoKey                String?          @map("logo_key")
  minDriverAge           Int              @default(21) @map("min_driver_age")
  minLicenseYears        Int              @default(2) @map("min_license_years")
  freeCancellationHours  Int              @default(48) @map("free_cancellation_hours")
  instantConfirmation    Boolean          @default(false) @map("instant_confirmation")
  acceptedPaymentMethods PaymentMethod[]  @default([CASH]) @map("accepted_payment_methods")
  /// Matricule fiscal (ex. 1234567/A/M/000), vide tant qu'il n'est pas déclaré.
  taxId                  String           @default("") @map("tax_id")
  plan                   SubscriptionPlan @default(STARTER)
  /// Commission propre à l'agence en points de base (`null` = commission par défaut).
  commissionBps          Int?             @map("commission_bps")
  /// Dernière décision de l'administration et son motif (refus, suspension).
  decidedAt              DateTime?        @map("decided_at")
  statusReason           String?          @map("status_reason")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  governorate Governorate      @relation(fields: [governorateCode], references: [code])
  vehicles    Vehicle[]
  bookings    Booking[]
  reviews     Review[]
  documents   AgencyDocument[]
  invoices    Invoice[]

  @@index([status, governorateCode])
  @@map("agencies")
}

/// Pièce justificative déposée par une agence (une par type).
model AgencyDocument {
  id         String             @id @default(cuid())
  agencyId   String             @map("agency_id")
  kind       AgencyDocumentKind
  /// Clé de l'objet dans le stockage S3.
  fileKey    String             @map("file_key")
  uploadedAt DateTime           @default(now()) @map("uploaded_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, kind])
  @@map("agency_documents")
}

/// Facture mensuelle d'abonnement (et de commission) émise à une agence.
/// Le statut se déduit : réglée si `paidAt`, en retard après `dueAt`, sinon émise.
model Invoice {
  id                   String           @id @default(cuid())
  number               String           @unique
  agencyId             String           @map("agency_id")
  /// Mois facturé « AAAA-MM ».
  period               String
  plan                 SubscriptionPlan
  subscriptionMillimes Int              @map("subscription_millimes")
  commissionMillimes   Int              @map("commission_millimes")
  subtotalMillimes     Int              @map("subtotal_millimes")
  vatRateBps           Int              @map("vat_rate_bps")
  vatMillimes          Int              @map("vat_millimes")
  fiscalStampMillimes  Int              @map("fiscal_stamp_millimes")
  totalMillimes        Int              @map("total_millimes")
  issuedAt             DateTime         @map("issued_at")
  dueAt                DateTime         @map("due_at")
  paidAt               DateTime?        @map("paid_at")
  paymentMethod        PaymentMethod?   @map("payment_method")
  remindedAt           DateTime?        @map("reminded_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@unique([agencyId, period])
  @@index([paidAt, dueAt])
  @@map("invoices")
}

/// Catégorie de véhicule, gérée par l'administration.
model VehicleCategory {
  id            String   @id @default(cuid())
  /// Identifiant stable des URL de recherche (ex. « suv »), fixé à la création.
  slug          String   @unique
  nameFr        String   @map("name_fr")
  nameAr        String   @map("name_ar")
  nameEn        String   @map("name_en")
  descriptionFr String   @default("") @map("description_fr")
  descriptionAr String   @default("") @map("description_ar")
  descriptionEn String   @default("") @map("description_en")
  /// Ordre d'affichage croissant.
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]

  @@map("vehicle_categories")
}

/// Marque proposée aux agences pour leur flotte. `Vehicle.brand` en recopie le nom.
model VehicleBrand {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  models    VehicleModel[]

  @@map("vehicle_brands")
}

/// Modèle d'une marque (ex. BMW X6). Le nom est recopié sur les véhicules (`Vehicle.model`).
model VehicleModel {
  id        String       @id @default(cuid())
  brandId   String       @map("brand_id")
  name      String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  brand     VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@map("vehicle_models")
}

model Vehicle {
  id                String          @id @default(cuid())
  agencyId          String          @map("agency_id")
  /// Nom d'une marque de `vehicle_brands`, renommé avec elle.
  brand             String
  model             String
  year              Int
  /// Forme canonique « 123 TU 4567 » ; facultative.
  plateNumber       String?         @map("plate_number")
  categoryId        String          @map("category_id")
  transmission      Transmission
  fuel              FuelType
  seats             Int
  airConditioning   Boolean         @map("air_conditioning")
  dailyRateMillimes Int             @map("daily_rate_millimes")
  depositMillimes   Int             @map("deposit_millimes")
  /// `null` : kilométrage illimité.
  mileageLimitKm    Int?            @map("mileage_limit_km")
  status            VehicleStatus   @default(ACTIVE)
  /// Couleur de carrosserie (hexadécimal), utilisée pour la vignette.
  color             String
  mileageKm         Int             @default(0) @map("mileage_km")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  agency   Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings Booking[]
  photos   VehiclePhoto[]

  @@unique([agencyId, plateNumber])
  @@index([agencyId, status])
  @@index([categoryId, status])
  @@index([brand])
  @@map("vehicles")
}

/// Photo d'un véhicule, stockée dans le bucket public en deux tailles (WebP).
model VehiclePhoto {
  id         String   @id @default(cuid())
  vehicleId  String   @map("vehicle_id")
  /// Préfixe des objets du bucket : « <préfixe>/lg.webp » et « <préfixe>/sm.webp ».
  storageKey String   @unique @map("storage_key")
  /// Ordre d'affichage ; la plus petite position est la couverture.
  position   Int
  width      Int
  height     Int
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
  @@map("vehicle_photos")
}

/// Réservation d'un véhicule. Le prix est figé à la création ; aucun paiement en ligne.
model Booking {
  id                String        @id @default(cuid())
  reference         String        @unique
  agencyId          String        @map("agency_id")
  vehicleId         String        @map("vehicle_id")
  customerId        String        @map("customer_id")
  pickupLocationId  String?       @map("pickup_location_id")
  pickupAt          DateTime      @map("pickup_at")
  returnAt          DateTime      @map("return_at")
  /// Libellés traduits du lieu de prise en charge et de retour ({ fr, ar, en }).
  pickupPlace       Json          @map("pickup_place")
  returnPlace       Json          @map("return_place")
  status            BookingStatus @default(PENDING)
  dailyRateMillimes Int           @map("daily_rate_millimes")
  totalMillimes     Int           @map("total_millimes")
  depositMillimes   Int           @map("deposit_millimes")
  customerNote      String?       @map("customer_note")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  agency         Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer       User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickupLocation Location?      @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  events         BookingEvent[]
  payments       Payment[]
  review         Review?

  @@index([agencyId, status])
  @@index([agencyId, pickupAt])
  @@index([agencyId, createdAt])
  @@index([vehicleId, pickupAt])
  @@index([customerId, createdAt])
  @@map("bookings")
}

/// Historique des changements de statut d'une réservation (ajout seul).
model BookingEvent {
  id        String        @id @default(cuid())
  bookingId String        @map("booking_id")
  status    BookingStatus
  reason    String?
  actorId   String?       @map("actor_id")
  createdAt DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

/// Encaissement déclaré par l'agence (la plateforme ne traite aucun paiement).
model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @map("booking_id")
  kind           PaymentKind
  method         PaymentMethod
  amountMillimes Int           @map("amount_millimes")
  note           String?
  recordedById   String?       @map("recorded_by_id")
  recordedAt     DateTime      @default(now()) @map("recorded_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

model Review {
  id               String                 @id @default(cuid())
  bookingId        String                 @unique @map("booking_id")
  agencyId         String                 @map("agency_id")
  customerId       String                 @map("customer_id")
  rating           Int
  comment          String
  reply            String?
  repliedAt        DateTime?              @map("replied_at")
  /// Les avis masqués ne sont plus publics ni comptés dans la note de l'agence.
  moderationStatus ReviewModerationStatus @default(PUBLISHED) @map("moderation_status")
  moderatedAt      DateTime?              @map("moderated_at")
  moderationReason String?                @map("moderation_reason")
  createdAt        DateTime               @default(now()) @map("created_at")

  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agency   Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customer User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reports  ReviewReport[]

  @@index([agencyId, createdAt])
  @@index([moderationStatus])
  @@map("reviews")
}

/// Signalement d'un avis (par l'agence concernée ou un utilisateur).
model ReviewReport {
  id         String             @id @default(cuid())
  reviewId   String             @map("review_id")
  reason     ReviewReportReason
  reporterId String?            @map("reporter_id")
  createdAt  DateTime           @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_reports")
}

// --- Audit -------------------------------------------------------------------

/// Journal immuable des actions sensibles : ajout seul, jamais modifié ni supprimé.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
