{
  "name": "@drivetn/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST DriveTN (NestJS)",
  "files": [
    "dist",
    "prisma",
    "docker-entrypoint.sh"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --path tsconfig.worker.json --entryFile worker",
    "dev:docker": "prisma migrate deploy && nest build && node dist/seed/seed.js && nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "seed": "node dist/seed/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "vitest run --config vitest.perf.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@azure/storage-blob": "12.28.0",
    "@drivetn/types": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "~6.19.3",
    "bullmq": "~5.81.5",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "^10.1.7",
    "prisma": "~6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@drivetn/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.15.47",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
